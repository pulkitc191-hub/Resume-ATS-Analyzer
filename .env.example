# Google Gemini AI API Key (Required for resume analysis)
GENKEY=your_gemini_api_key_here

# Brevo Mail API Key (Required for email verification & password reset)
MAILKEY=your_brevo_api_key_here

# Google OAuth Credentials (Optional: Google Sign-in)
GCPID=your_gcp_client_id_here
GCPSECRET=your_gcp_client_secret_here

# Adzuna API (Optional: Job suggestions)
ADZUNAID=your_adzuna_app_id_here
ADZUNAKEY=your_adzuna_api_key_here

# JWT Secret Key
JWTKEY=your_custom_jwt_secret_key_123456789
